{
	"name": "eumenes-world-model",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./sqlite": "./src/sqlite.ts"
	},
	"scripts": {
		"verify": "bun scripts/verify.ts",
		"verify:all": "bun scripts/verify.ts --all",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"check:boundaries": "bun scripts/check-boundaries.ts",
		"test": "bun test ./src ./test",
		"test:sqlite": "bun test ./test/sqlite",
		"build": "tsc -p tsconfig.build.json",
		"test:domain": "bun scripts/test-domain.ts",
		"bench:world": "bun scripts/bench-world.ts",
		"pack:local": "bun scripts/pack.ts",
		"eval:extraction": "bun eval/extraction/main.ts",
		"eval:decision": "bun eval/decision/main.ts",
		"eval:cache-latency": "bun eval/scenarios/cache-latency/main.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"eumenes-memory": "file:./vendor/eumenes-memory",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3"
	},
	"packageManager": "bun@1.4.2"
}
