{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		"noEmit": false,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"test",
		"scripts",
		"src/**/*.test.ts",
		"src/**/test/**",
		"src/**/*.spec.ts"
	]
}
